            <field name="arch" type="xml">
                <form string="Real Property Tax">
                    <header>
                        <field name="state" widget="statusbar"/>
                        <button name="confirm" class="oe_highlight" states="draft" string="Confirm" type="object"/>
                        <button name="cancel" class="oe_highlight" states="draft" string="Cancel" type="object"/>
                        <button name="set_to_draft" class="oe_highlight" states="confirm" string="Set To Draft" type="object"/>
                    </header>
                    <sheet>
                        <div class="oe_title" string="Document #">
                            <h1>
                                <field name="leaf_id" attrs="{'readonly': [('state', '!=', 'draft')]}" domain="[('state','=','available'),('form_name','=','Official Receipt Property Tax')]" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="payor" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="type" invisible="1"/>
                                <field name="amount" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                            <group>
                                <field name="payment_type" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="cheque_bank" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('payment_type','!=','cheque')]}"/>
                                <field name="cheque_number" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('payment_type','!=','cheque')]}"/>
                                <field name="cheque_date" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('payment_type','!=','cheque')]}"/>
                                <field name="officer_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Details">
                                <field name="line_ids" attrs="{'readonly': [('state', '!=', 'draft')]}">
                                    <tree>
                                        <field name="name"/>
<!--                                        <field name="location"/>-->
<!--                                        <field name="lot"/>-->
                                        <field name="td_no"/>
<!--                                        <field name="av_land" />-->
<!--                                        <field name="av_improvements" />-->
                                        <field name="av_total" />
                                        <field name="tax_due" />
<!--                                        <field name="inst_no" />-->
                                        <field name="inst_payment" />
                                        <field name="full_payment" />
                                        <field name="penalty" />
                                        <field name="total" sum="Total"/>
                                    </tree>
                                    <form>
                                        <group>
                                            <group>
                                                <field name="name" />
                                                <field name="location" />
                                                <field name="lot" />
                                                <field name="td_no" />
                                            </group>
                                            <group>
                                                <separator string="Assessed Value"/>
                                                <field name="av_land" />
                                                <field name="av_improvements" />
                                                <field name="av_total" />
                                                <separator/>
                                                <field name="tax_due" />
                                                <separator string="Installment"/>
                                                <field name="inst_no" />
                                                <field name="inst_payment" />
                                                <separator/>
                                                <field name="full_payment" />
                                                <field name="penalty" />
                                                <field name="total" />
                                            </group>
                                        </group>
                                    </form>
                                </field>
                            </page>
                        </notebook>

                    </sheet>
                    <div class="oe_chatter">
	                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
	                    <field name="message_ids" widget="mail_thread"/>
	                </div>
                </form>
            </field>
        </record>

