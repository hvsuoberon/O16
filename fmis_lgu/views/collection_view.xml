<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="fmis_collection_form_view">
            <field name="name">fmis.collection.form</field>
            <field name="model">fmis.collection</field>
            <field name="arch" type="xml">
                <form string="Collection">
                    <header>
                        <field name="state" widget="statusbar"/>
                        <button name="confirm" class="oe_highlight" states="draft" string="Confirm" type="object"/>
                        <button name="cancel" class="oe_highlight" states="draft" string="Cancel" type="object"/>
                        <button name="set_to_draft" class="oe_highlight" states="confirm" string="Set To Draft" type="object"/>
                    </header>
                    <sheet>
                        <div class="oe_title" string="Document #">
                            <h1>
                                <field name="leaf_id" attrs="{'readonly': [('state', '!=', 'draft')]}" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="payor" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="type" invisible="1"/>
                                <field name="amount" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                            <group>
                                <field name="payment_type" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="cheque_bank" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('payment_type','!=','cheque')]}"/>
                                <field name="cheque_number" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('payment_type','!=','cheque')]}"/>
                                <field name="cheque_date" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('payment_type','!=','cheque')]}"/>
                                <field name="officer_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                        </group>

                    </sheet>
                    <div class="oe_chatter">
	                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
	                    <field name="message_ids" widget="mail_thread"/>
	                </div>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="fmis_collection_tree_view">
            <field name="name">fmis.collection.tree</field>
            <field name="model">fmis.collection</field>
            <field name="arch" type="xml">
                <tree string="Collection">
                    <field name="leaf_id"/>
                    <field name="date"/>
                    <field name="payor"/>
                    <field name="amount"/>
                    <field name="state"
                           decoration-danger="state == 'draft'"
                           decoration-info="state == 'draft'"
                           decoration-muted="state == 'cancel'"
                           decoration-success="state == 'posted'"
                           widget="badge"
                    />
                    <field name="officer_id" optional="show" widget="many2one_avatar_user"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="fmis_collection_search_view">
            <field name="name">fmis.collection.search</field>
            <field name="model">fmis.collection</field>
            <field name="arch" type="xml">
                <search>
                    <field name="leaf_id"/>
                    <field name="payor"/>
                    <field name="cheque_number"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="fmis_collection_action">
            <field name="name">Collection</field>
            <field name="res_model">fmis.collection</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first Collection Form
                </p>
            </field>
        </record>

<!--        =====================================================================-->
        <record model="ir.ui.view" id="fmis_collection_burial_form_view">
