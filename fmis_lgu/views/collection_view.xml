                                <field name="officer_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Details">
                                <group>
                                    <field name="permission_type" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
