<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="fmis_disbursement_form_view">
            <field name="name">fmis.disbursement.form</field>
            <field name="model">fmis.disbursement</field>
            <field name="arch" type="xml">
                <form string="Disbursement">
                    <header>
                        <field name="state" widget="statusbar"/>
                        <button name="confirm" class="oe_highlight" states="draft" string="Confirm" type="object"/>
                        <button name="bir_forms" class="oe_highlight" states="check_print" string="For Cheque Printing" type="object"/>
                        <button name="cheque_release" class="oe_highlight" states="bir_forms" string="BIR Forms" type="object"/>
                        <button name="released" class="oe_highlight" states="cheque_release" string="Release" type="object"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="obr_id" attrs="{'readonly': [('state', '!=', 'draft')]}" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="payee" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                            <group>
                                <field name="bank_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="cheque_number" attrs="{'readonly': [('state', '!=', 'draft')]}" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                <field name="cheque_date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Particulars">
                                <label for="particulars" string="Particulars"/>
                                <field name="particulars" widget="text" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
<!--                                <group col="4" colspan="4">-->
<!--                                    <field name="particulars" widget="text" class="my_full_width"/>-->
<!--                                </group>-->
                                <group>
                                    <group>
                                        <field name="amount" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                        <field name="amount_due" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="tax_3" readonly="1"/>
                                        <field name="tax_1" readonly="1"/>
                                    </group>
                                </group>
                            </page>
<!--                            <page string="Signatories">-->

<!--                            </page>-->
                        </notebook>

                        <group name="signatories" string="Signatories">
                            <group>
                                <field name="certified_a"/>
                                <field name="certified_b"/>
                                <field name="certified_c"/>
                            </group>
                            <group>
                                <field name="approved"/>
                                <field name="prepared_by"/>
                                <field name="certified_by"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
	                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
	                    <field name="message_ids" widget="mail_thread"/>
	                </div>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="fmis_disbursement_tree_view">
            <field name="name">fmis.disbursement.tree</field>
            <field name="model">fmis.disbursement</field>
            <field name="arch" type="xml">
                <tree string="Disbursement">
                    <field name="name"/>
                    <field name="obr_id"/>
                    <field name="payee"/>
                    <field name="cheque_number"/>
                    <field name="cheque_date"/>
                    <field name="state"
                           decoration-danger="state == 'draft'"
                           decoration-info="state == 'check_print'"
                           decoration-warning="state == 'bir_forms'"
                           decoration-muted="state == 'cheque_release'"
                           decoration-success="state == 'released'"
                           widget="badge"
                    />
                    <field name="create_uid" optional="show" widget="many2one_avatar_user"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="fmis_disbursement_search_view">
            <field name="name">fmis.disbursement.search</field>
            <field name="model">fmis.disbursement</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="obr_id"/>
                    <field name="payee"/>
                    <field name="bank_id"/>
                    <field name="cheque_number"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="fmis_disbursement_action">
            <field name="name">Disbursement</field>
            <field name="res_model">fmis.disbursement</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first Disbursement Form
                </p>
            </field>
        </record>

        <record model="ir.actions.act_window" id="fmis_disbursement_for_advice_action">
            <field name="name">Tag Advice For Local Disbursement</field>
            <field name="res_model">fmis.disbursement</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('advice_id','=',False),('state','=','released')]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first Disbursement Form
                </p>
            </field>
        </record>

    <record id="open_advice" model="ir.actions.server">
        <field name="name">Create Accountants Advice</field>
        <field name="model_id" ref="fmis_lgu.model_fmis_disbursement"/>
        <field name="binding_model_id" ref="fmis_lgu.model_fmis_disbursement"/>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.add_to_aa()
        </field>
    </record>


        <record model="ir.ui.view" id="fmis_disbursement_advice_form_view">
            <field name="name">fmis.disbursement.advice.form</field>
            <field name="model">fmis.disbursement.advice</field>
            <field name="arch" type="xml">
                <form string="Advice on Local Cheque Disbursement">
                    <header>
                        <field name="state" widget="statusbar"/>
                        <button name="confirm" class="oe_highlight" states="draft" string="Confirm" type="object"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="company_id" invisible="True"/>
                            </group>
                            <group>
                            </group>
                        </group>
                        <field name="disbursement_ids" attrs="{'readonly': [('state', '!=', 'draft')]}" nolabel="1">
                            <tree editable="top">
                                <field name="bank_id" readonly="1"/>
                                <field name="cheque_number" readonly="1"/>
                                <field name="cheque_date" readonly="1"/>
                                <field name="payee" readonly="1"/>
                                <field name="amount" readonly="1" sum="Total"/>
                            </tree>
                        </field>
                        <group name="certified" string="Signatories">
                            <group>
                                <field name="municipal_accountant"/>
                                <field name="officer_in_charge"/>
                            </group>
                            <group>
                                <field name="prepared_by"/>
                                <field name="prepared_by_pos"/>
                                <field name="delivered_by"/>
                                <field name="delivered_by_pos"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
	                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
	                    <field name="message_ids" widget="mail_thread"/>
	                </div>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="fmis_disbursement_advice_tree_view">
            <field name="name">fmis.disbursement.advice.tree</field>
            <field name="model">fmis.disbursement.advice</field>
            <field name="arch" type="xml">
                <tree string="Default Value">
                    <field name="name"/>
                    <field name="bank_id"/>
                    <field name="date"/>
                    <field name="total"/>
                    <field name="state"
                           decoration-success="state == 'confirm'"
                           widget="badge"
                    />
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="fmis_disbursement_advice_search_view">
            <field name="name">fmis.disbursement.advice.search</field>
            <field name="model">fmis.disbursement.advice</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="bank_id"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="fmis_disbursement_advice_action">
            <field name="name">Accountant's Advice</field>
            <field name="res_model">fmis.disbursement.advice</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first Accountant's Advice
                </p>
            </field>
        </record>
    </data>
</odoo>
