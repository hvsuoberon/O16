	<template id="report_advice_document">
		<t t-call="web.html_container">
			<t t-foreach="docs" t-as="o">
				<t t-call="fmis_lgu.advice_external_layout">

					<div class="page ebsfont"> <!-- Page container -->

						<div class="row mt16">
							<div class="col-12" style="text-align: center;">
								<span style="font-weight: bold; font-size: 13px;">
									ACCOUNTANT'S ADVICE
								</span>
								<br/>
								<span style="font-weight: bold; font-size: 13px;">
									OF LOCAL CHECK DISBURSEMENT
								</span>
								<br/>
							</div>

							<div class="col-12">
								<table class="ebs_table ebs_bg64" style="border: 1px solid #000; border-collapse: collapse; font-size:12px; width:100%;">
									<thead>
										<tr>
											<th style="width: 10%; border: 1px solid #000; text-align: center; background-color:#bfbcb9; color:#000;">Bank Account No.</th>
											<th style="width: 15%; border: 1px solid #000; text-align: center; background-color:#bfbcb9; color:#000;">Check Number</th>
											<th style="width: 10%; border: 1px solid #000; text-align: center; background-color:#bfbcb9; color:#000;">Date</th>
											<th style="width: 45%; border: 1px solid #000; text-align: center; background-color:#bfbcb9; color:#000;">Payee</th>
											<th style="width: 20%; border: 1px solid #000; text-align: center; background-color:#bfbcb9; color:#000;">Amount</th>
										</tr>
									</thead>
									<t t-set="total_amount" t-value="0"/>
									<t t-foreach="o.disbursement_ids" t-as="s">
										<t t-set="total_amount" t-value="total_amount + s.amount_due"/>
										<tr>
											<td style="text-align:center; border: 1px solid #000;">
												<span t-field="s.bank_id.display_name"/>
											</td>
											<td style="text-align:center; border: 1px solid #000;">
												<span t-field="s.cheque_number.series"/>
											</td>
											<td style="text-align:center; border: 1px solid #000;">
												<span>
													<t t-esc="time.strftime('%m/%d/%Y', time.strptime(str(s.date), '%Y-%m-%d'))"/>
												</span>
											</td>
											<td style="text-align:left; border: 1px solid #000; padding:8px;">
												<span t-field="s.payee"/>
											</td>
											<td style="text-align:right; border: 1px solid #000; padding:8px;">
												<span t-esc="'{0:,.2f}'.format(s.amount_due)"/>
											</td>
										</tr>
									</t>
									<tr>
										<td colspan="4" style="text-align:right; font-weight:bold; background:#f2f2f2;  border: 1px solid #000;">
											TOTAL
										</td>
										<td style="text-align:right; font-weight:bold; background:#f2f2f2;  border: 1px solid #000; padding:8px;">
											<span t-esc="'{0:,.2f}'.format(total_amount)"/>
										</td>
									</tr>
									<tr>
										<td colspan="1" style="text-align:center; font-weight:bold;  background:#f2f2f2; border: 1px solid #000;">
											AMOUNT IN WORDS:
										</td>
										<td colspan="4" style="text-align:right; font-weight:bold; background:#f2f2f2;  border: 1px solid #000; padding:8px;">
											***
											<span style="text-transform: uppercase;" t-esc="o.company_id.currency_id.amount_to_text(total_amount)"/>
											***
										</td>
									</tr>
								</table>
							</div>
						</div>

						<div class="footer" style="position:fixed; bottom:0; left:0; right:0; height:230px; font-size:11px;">
							<table class="footer-table" style="width:100%; border-collapse:collapse; border:none;">
								<tr>
									<td style="width:3%; padding:8px;"></td>
									<td style="width:30%; text-align:left; padding:8px;">
										<span>Certified Correct</span>
									</td>
									<td style="width:2%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px;">
									</td>
									<td style="width:2%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px;">
									</td>
									<td style="width:3%; padding:3px;"></td>
								</tr>
								<tr>
									<td style="width:3%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px; border-bottom: 1px solid #000;">
										<span t-field="o.municipal_accountant"/>
									</td>
									<td style="width:2%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px; border-bottom: 1px solid #000;">
										<span t-field="o.officer_in_charge"/>
									</td>
									<td style="width:2%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px; border-bottom: 1px solid #000;">
										<!-- Optional Signature -->
									</td>
									<td style="width:3%; padding:3px;"></td>
								</tr>
								<tr>
									<td style="width:3%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px;">
										<span>Municipal Accountant</span>
									</td>
									<td style="width:2%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px;">
										<span>Officer In-Charge</span>
									</td>
									<td style="width:2%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px;">
										<span>Bank Representative</span>
									</td>
									<td style="width:3%; padding:3px;"></td>
								</tr>
								<tr>
									<td style="width:3%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px;">
									</td>
									<td style="width:2%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px;">
									</td>
									<td style="width:2%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px; border-bottom: 1px solid #000;">

									</td>
									<td style="width:3%; padding:3px;"></td>
								</tr>
								<tr>
									<td style="width:3%; padding:8px;"></td>
									<td style="width:30%; text-align:left; padding:8px;">
										<span>Prepared By</span>
									</td>
									<td style="width:2%; padding:8px;"></td>
									<td style="width:30%; text-align:left; padding:8px;">
										<span>Delivered By</span>
									</td>
									<td style="width:2%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px; ">
										<span>Date Received</span>
									</td>
									<td style="width:3%; padding:3px;"></td>
								</tr>
								<tr>
									<td style="width:3%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px; border-bottom: 1px solid #000;">
										<span t-field="o.prepared_by"/>
									</td>
									<td style="width:2%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px; border-bottom: 1px solid #000;">
										<span t-field="o.delivered_by"/>
									</td>
									<td style="width:2%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px;">
										<!-- Optional Signature -->
									</td>
									<td style="width:3%; padding:3px;"></td>
								</tr>
								<tr>
									<td style="width:3%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px;">
										<span t-field="o.prepared_by_pos"/>
									</td>
									<td style="width:2%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px;">
										<span t-field="o.delivered_by_pos"/>
									</td>
									<td style="width:2%; padding:8px;"></td>
									<td style="width:30%; text-align:center; padding:8px;">
									</td>
									<td style="width:3%; padding:3px;"></td>
								</tr>
							</table>
						</div>

					</div>
				</t>
			</t>
		</t>
	</template>
</odoo>
