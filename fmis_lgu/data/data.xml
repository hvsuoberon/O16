<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="seq_accountable_form_entry" model="ir.sequence">
            <field name="name">Accountable Forms</field>
            <field name="code">accountable.forms</field>
            <field name="prefix">AF</field>
            <field name="padding">5</field>
        </record>

        <record id="accountable_form_burial" model="fmis.accounting.form.type">
            <field name="name">Burial Permit and Fee</field>
            <field name="limit">0</field>
            <field name="code">BPF</field>
        </record>
        <record id="accountable_form_cash_ticket" model="fmis.accounting.form.type">
            <field name="name">Cash Ticket</field>
            <field name="limit">0</field>
            <field name="code">CT</field>
        </record>
        <record id="accountable_form_marriage" model="fmis.accounting.form.type">
            <field name="name">Marriage License and Fee Receipt</field>
            <field name="limit">0</field>
            <field name="code">MLFR</field>
        </record>
        <record id="accountable_form_property" model="fmis.accounting.form.type">
            <field name="name">Official Receipt Property Tax</field>
            <field name="limit">0</field>
            <field name="code">ORPT</field>
        </record>
        <record id="accountable_form_or" model="fmis.accounting.form.type">
            <field name="name">Official Receipt</field>
            <field name="limit">0</field>
            <field name="code">OR</field>
        </record>
        <record id="accountable_form_cattle" model="fmis.accounting.form.type">
            <field name="name">Cert of Transfer of Ownership of Large Cattle</field>
            <field name="limit">0</field>
            <field name="code">CTOLC</field>
        </record>
        <record id="accountable_form_cattle_ownership" model="fmis.accounting.form.type">
            <field name="name">Cert of Ownership of Large Cattle</field>
            <field name="limit">0</field>
            <field name="code">COLC</field>
        </record>
        <record id="accountable_form_cheque" model="fmis.accounting.form.type">
            <field name="name">Cheque</field>
            <field name="limit">0</field>
            <field name="code">CHQ</field>
        </record>

        <record id="seq_disbursement" model="ir.sequence">
            <field name="name">FMIS Disbursement</field>
            <field name="code">fmis.disbursement</field>
            <field name="prefix">CD-%(year)s-</field>
            <field name="padding">10</field>
        </record>
        <record id="seq_cheque_clearing" model="ir.sequence">
            <field name="name">FMIS Cheque Clearing</field>
            <field name="code">fmis.cheque.clearing</field>
            <field name="prefix">CC-%(year)s-</field>
            <field name="padding">10</field>
        </record>
        <record id="seq_deposit" model="ir.sequence">
            <field name="name">FMIS Collection Deposit</field>
            <field name="code">fmis.collection.deposit</field>
            <field name="prefix">DS-%(year)s-</field>
            <field name="padding">10</field>
        </record>

        <record id="seq_stub_request" model="ir.sequence">
            <field name="name">Replenishment of Accountable Forms</field>
            <field name="code">stub.assignment</field>
            <field name="prefix">RAF-%(year)s-</field>
            <field name="padding">10</field>
        </record>
    </data>
</odoo>

