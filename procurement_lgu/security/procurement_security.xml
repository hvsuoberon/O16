<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data noupdate="0">
		<record model="ir.module.category" id="lguproc_module_management">
		  <field name="name">LGU Procurement</field>
		  <field name="description">User access level for this module</field>
		  <field name="sequence">3</field>
		</record>
	
	   <record id="lguproc_user" model="res.groups">
	     <field name="name">User</field>
	     <field name="category_id" ref="procurement_lgu.lguproc_module_management"/>
	    </record>
	
	   <record id="lguproc_incharge" model="res.groups">
	     <field name="name">BAC In-Charge</field>
	     <field name="category_id" ref="procurement_lgu.lguproc_module_management"/>
	     <field name="implied_ids" eval="[(4, ref('procurement_lgu.lguproc_user'))]"/>
	    </record>
	    
	   <record id="lguproc_head" model="res.groups">
	     <field name="name">BAC Head</field>
	     <field name="category_id" ref="procurement_lgu.lguproc_module_management"/>
	     <field name="implied_ids" eval="[(4, ref('procurement_lgu.lguproc_incharge'))]"/>
	    </record>
	
	</data>

</odoo>
