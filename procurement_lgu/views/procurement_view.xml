    	<!-- ################################################ start -->
        <record model="ir.ui.view" id="procurement_plan_form_view">
            <field name="name">procurement.plan.form</field>
            <field name="model">procurement.plan</field>
            <field name="arch" type="xml">
                <form string="Procurement Plan">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="cancel" states="cancel"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,approved" states="draft,confirmed,approved"/>
                    	<button name="confirm" class="oe_highlight" states="draft" string="Confirm" type="object" groups="procurement_lgu.lguproc_incharge,procurement_lgu.lguproc_head"/>
                    	<button name="approve" class="oe_highlight" states="confirmed" string="Approve" type="object" groups="procurement_lgu.lguproc_head"/>
                    	<button name="cancel" class="oe_highlight" states="confirmed" string="Cancel" type="object" 
                    		confirm="Are you sure you want cancel the transaction?"/>
                    	<button name="draft" class="oe_highlight" states="confirmed" string="Set to Draft" type="object" groups="procurement_lgu.lguproc_head"/>
                    	<button name="draft" class="oe_highlight" states="approved,cancel" string="Set to Draft" type="object" groups="procurement_lgu.lguproc_head"/>
                    	<!-- <button name="update_unit_price" class="oe_highlight" states="draft" string="Update Unit Price" type="object" /> -->
                    </header>                
                     <sheet>
	                    <div class="oe_title">
	                        <h1>
	                            <field name="name" readonly="1"/>
	                        </h1>
	                    </div>
                        <group>
                        	<group>
                        		<field name="partner_id" required="True" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        		<field name="date" required="True" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="source_id" required="True" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        	</group>
                        	<group>
                        		<field name="year" required="True" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        		<field name="project_id" required="True" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        	</group>
                        </group>
                        
						<notebook colspan="4">
	                        <page string="Details">
	                            <field name="ppd_ids" mode="tree,kanban" attrs="{'readonly': [('state', '!=', 'draft')]}">
	                                <tree>
	                                	<field name="account_id" required="1"/>
                                        <field name="mode_id" required="1"/>

	                                	<!--
	                                    <field name="product_id"/>
	                                    <field name="product_uom_id"/>
	                                    -->
<!--	                                    <field name="mode_id"/>-->
<!--	                                    <field name="month_01"/>-->
<!--	                                    <field name="month_02"/>-->
<!--	                                    <field name="month_03"/>-->
<!--	                                    <field name="month_04"/>-->
<!--	                                    <field name="month_05"/>-->
<!--	                                    <field name="month_06"/>-->
<!--	                                    <field name="month_07"/>-->
<!--	                                    <field name="month_08"/>-->
<!--	                                    <field name="month_09"/>-->
<!--	                                    <field name="month_10"/>-->
<!--	                                    <field name="month_11"/>-->
<!--	                                    <field name="month_12"/>-->
	                                    <field name="qty_disp" readonly="True"/>
	                                    <field name="qty" invisible="True"/>
	                                    <field name="unit_price"/>
	                                    <field name="est_budget" sum="Total" readonly="True"/>
	                                </tree>
                                    <form>
                                        <group>
                                            <group>
                                                <field name="account_id" required="1"/>
                                                <field name="mode_id" required="1"/>
                                            </group>
                                            <group>
                                                <field name="month_01"/>
                                                <field name="month_02"/>
                                                <field name="month_03"/>
                                                <field name="month_04"/>
                                                <field name="month_05"/>
                                                <field name="month_06"/>
                                                <field name="month_07"/>
                                                <field name="month_08"/>
                                                <field name="month_09"/>
                                                <field name="month_10"/>
                                                <field name="month_11"/>
                                                <field name="month_12"/>
                                                <field name="qty_disp" readonly="True"/>
                                                <field name="qty" invisible="True"/>
                                                <field name="unit_price"/>
                                                <field name="est_budget" sum="Total" readonly="True"/>
                                            </group>
                                        </group>
                                    </form>
	                            </field>
							
	                        </page>
	                    </notebook>
	                    
	                    <group>
                        	<group>
                        		<field name="prepared_by" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        		<field name="prepared_by_des" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        	</group>
                        	<group>
                        		<field name="approved_by" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        		<field name="approved_by_des" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        	</group>
                        </group>
                     </sheet>

	                <div class="oe_chatter">
	                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
	                    <field name="message_ids" widget="mail_thread"/>
	                </div>
                
                </form>
            </field>
        </record>

		<record id="view_pp_filter" model="ir.ui.view">
            <field name="name">procurement.plan.select</field>
            <field name="model">procurement.plan</field>
            <field name="arch" type="xml">
                <search string="Search">
<!--                    <filter string="Current Year" name="currentyear" -->
<!--						domain="[('year','=',context_today().strftime('%Y'))]" />-->
					<filter name="f2020" string="Year 2020" domain="[('year','=','2020')]"/>
					<filter name="f2021" string="Year 2021" domain="[('year','=','2021')]"/>
					<filter name="f2022" string="Year 2022" domain="[('year','=','2022')]"/>
					<filter name="f2023" string="Year 2023" domain="[('year','=','2023')]"/>
					<filter name="f2024" string="Year 2024" domain="[('year','=','2024')]"/>
					<filter name="f2025" string="Year 2025" domain="[('year','=','2025')]"/>						
                    <field name="partner_id"/>
                    <field name="name"/>
                    <field name="state"/>
<!--					<group expand="0" string="Group By">-->
<!--                        <filter string="Procurement Unit" domain="[]" context="{'group_by':'partner_id'}"/>-->
<!--                    </group>-->
                </search>
            </field>
        </record>

