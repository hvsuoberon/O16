    	<!-- ################################################ start -->
        <record model="ir.ui.view" id="procurementproject_form_view">
            <field name="name">procurement.project.form</field>
            <field name="model">procurement.project</field>
            <field name="arch" type="xml">
                <form string="Project">
                    <sheet>
	                    <div class="oe_button_box" name="button_box">
	                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
	                            <field name="active" widget="boolean_button" options="{&quot;terminology&quot;: &quot;archive&quot;}"/>
	                        </button>
	                    </div>                    
						<div class="oe_title">
	                        <h1>
	                            <field name="name" readonly="1"/>
	                        </h1>
	                    </div>                    
                        <group>
                            <field name="code"/>
                            <field name="descript"/>
                            <field name="start_date"/>
                            <field name="end_date"/>              
                            <field name="dyear" readonly="1"/>              
                        </group>
                        <notebook>
                            <page string="Notes">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record model="ir.ui.view" id="procurementproject_search_view">
            <field name="name">procurementproject.search</field>
            <field name="model">procurement.project</field>
            <field name="arch" type="xml">
                <search>
                    <filter string="Current Year" name="currentyear" 
						domain="[('dyear','=',context_today().strftime('%Y'))]" />
					<filter name="f2020" string="Year 2020" domain="[('dyear','=','2020')]"/>
					<filter name="f2021" string="Year 2021" domain="[('dyear','=','2021')]"/>
					<filter name="f2022" string="Year 2021" domain="[('dyear','=','2022')]"/>
					<filter name="f2023" string="Year 2021" domain="[('dyear','=','2023')]"/>	
                    <field name="name"/>
                    <field name="code"/>
                    <field name="descript"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="procurementproject_tree_view">
            <field name="name">procurementproject.tree</field>
            <field name="model">procurement.project</field>
            <field name="arch" type="xml">
                <tree string="Project Tree">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="descript"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="procurementproject_list_action">
            <field name="name">Project</field>
            <field name="res_model">procurement.project</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_currentyear': True}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first project
                </p>
            </field>
        </record>
