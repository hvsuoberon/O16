<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Top menu item -->
        <menuitem name="Procurement"
            id="purchase.menu_purchase_root"
            groups="purchase.group_purchase_manager,purchase.group_purchase_user,procurement_lgu.lguproc_user,procurement_lgu.lguproc_incharge,procurement_lgu.lguproc_head"
            web_icon="purchase,static/description/icon.png"
            sequence="25"/>


        <record id="purchase_level1" model="ir.actions.act_window">
            <field name="name">RFQ (Less Than 50K)</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">purchase.order</field>
            <field name="domain" eval="[('transaction_level','=',(ref('pol_level1')))]"/>
            <field name="context" eval="{'default_transaction_level': ref('pol_level1'),'default_year':time.strftime('%Y')}"/>
            <field name="view_mode">tree,kanban,form,pivot,graph,calendar</field>
            <field name="search_view_id" ref="purchase.view_purchase_order_filter"/>
            <field name="help" type="html">
              <p class="oe_view_nocontent_create">
                Click to create a request for quotation.
              </p><p>
                The quotation contains the history of the discussion/negotiation
                you had with your vendor. Once confirmed, a request for
                quotation is converted into a purchase order.
              </p><p>
                Most propositions of purchase orders are created automatically
                by Odoo based on inventory needs.
              </p>
            </field>
        </record>

		<record model="ir.ui.view" id="purchase_order_tree">
			<field name="name">purchase.order.tree.inherit</field>
			<field name="model">purchase.order</field>
			<field name="inherit_id" ref="purchase.purchase_order_tree" />
			<field name="arch" type="xml">
				<xpath expr="//field[@name='name']" position="after">
					<field name="pu_id"/>
					<field name="project_id"/>
				</xpath>
				<xpath expr="//field[@name='state']" position="before">
					<field name="year"/>
				</xpath>
			</field>
		</record>   

		<record model="ir.ui.view" id="purchase_order_form">
			<field name="name">purchase.order.form.inherit</field>
			<field name="model">purchase.order</field>
			<field name="inherit_id" ref="purchase.purchase_order_form" />
			<field name="arch" type="xml">
				<xpath expr="//field[@name='date_order']" position="after">
					<field name="transaction_level" attrs="{'readonly': [('state', 'not in', ('draft','sent'))]}"/>
					<field name="mode_id" attrs="{'readonly': [('state', 'not in', ('draft','sent'))]}"/>
				</xpath>
				<xpath expr="//field[@name='partner_id']" position="before">
					<field name="pu_id" context="{'filter_pu':True}" attrs="{'readonly': [('state', 'not in', ('draft','sent'))]}"/>
					<field name="project_id" attrs="{'readonly': [('state', 'not in', ('draft','sent'))]}"
						context="{'pu_id':pu_id, 'filter_project': True}"/>
					<field name="source_id" attrs="{'readonly': [('state', 'not in', ('draft','sent'))]}"/>
<!--
					<field name="program_id" attrs="{'readonly': [('state', 'not in', ('draft','sent'))]}"
						context="{'pu_id':pu_id, 'project_id': project_id,'program_id':program_id,'filter_program': True}"/>
-->				
				</xpath>
				<xpath expr="//field[@name='date_order']" position="before">
					<field name="year" attrs="{'readonly': [('state', 'not in', ('draft','sent'))]}"/>
				</xpath>
				<!--
				<xpath expr="//field[@name='order_line']" position="attributes">
					<attribute name="readonly">{'readonly': [('state', 'not in', ('draft','sent'))]}</attribute>
				</xpath>
				-->
				<xpath expr="//field[@name='order_line']/tree/field[@name='taxes_id']" position="attributes">
					<attribute name="invisible">1</attribute>
				</xpath>
				<xpath expr="//field[@name='partner_ref']" position="attributes">
					<attribute name="attrs">{'readonly': [('state', 'not in', ('draft','sent'))]}</attribute>
				</xpath>
				<xpath expr="//field[@name='requisition_id']" position="attributes">
					<attribute name="attrs">{'readonly': [('state', 'not in', ('draft','sent'))]}</attribute>
				</xpath>				
				
				<xpath expr="//field[@name='product_id']" position="replace">
					<field name="account_id" context="{'quantity':product_qty,'project_id':parent.project_id, 
								'company_id': parent.company_id, 'filter_procurement': True, 
								'pu_id':parent.pu_id, 'year':parent.year}"/>
					<field name="product_id" 
						attrs="{'readonly': [('state', 'in', ('purchase', 'to approve','done', 'cancel'))]}" 
						context="{'partner_id':parent.partner_id, 'quantity':product_qty,'uom':product_uom,'project_id':parent.project_id,
								'company_id': parent.company_id, 'filter_procurement': True, 
								'pu_id':parent.pu_id, 'mode_id':parent.mode_id,'year':parent.year}"
					/>
				</xpath>
				
                <xpath expr="//button[@name='action_rfq_send']" position="replace">
                </xpath>

                <xpath expr="//sheet/div/button[@name='action_view_picking']" position="attributes">
                	<attribute name="attrs">{}</attribute>
                	<attribute name="invisible">True</attribute>
                </xpath>
                <xpath expr="//sheet/notebook" position="inside">
					<page string="Signatories">
						<group>
							<group>
								<field name="conforme_by"/>
								<field name="conforme_designation"/>
							</group>
							<group>
								<field name="signatory"/>
								<field name="signatory_designation"/>
							</group>
						</group>
						<group>
							<group>
								<field name="proc_head"/>
								<field name="proc_head_designation"/>
							</group>
						</group>
					</page>
					<page string="Bid">
						<group>
							<group>
								<field name="bid_sec"/>
								<field name="bs_bank_comp"/>
								<field name="bs_number"/>
								<field name="bs_validity"/>
								<field name="bs_amount"/>
							</group>
							<group>
								<field name="reso_number" force_save="1" readonly="1"/>
								<field name="res_bs"/>
								<field name="sufficiency"/>
								<field name="bs_remarks"/>
							</group>
						</group>
					</page>
					<page string="Notice Of Award / Notice To Proceed" attrs="{'invisible': [('state', 'not in', ('purchase','done'))]}"  >
						<group>
							<group>
								<field name="supplier_owner"/>
								<field name="supplier_designation"/>
								<field name="salutation"/>
							</group>
							<group>
								<field name="noa_date"/>
								<field name="ntp_date"/>
							</group>
						</group>
					</page>
                </xpath>
				<xpath expr="//field[@name='incoterm_id']" position="after">
                    <field name="place_of_delivery"/>
					<field name="delivery_term"/>
                </xpath>
			</field>
		</record>   

    	<menuitem
    		name="Procurement"
	        id="menu_purchase_requisition_bidding"
	        sequence="10"
	        parent="purchase.menu_procurement_management"
	        action="purchase_requisition.action_purchase_requisition"/>

<!--        <menuitem action="purchase_level1" id="menu_purchase_level1"-->
<!--            parent="purchase.menu_procurement_management"-->
<!--            sequence="0"/>-->

		<!--        
		<record model="ir.ui.view" id="action_purchase_requisition">
			<field name="name">purchase.requisition.tree.inherit</field>
			<field name="model">purchase.requisition</field>
			<field name="inherit_id" ref="purchase_requisition.action_purchase_requisition" />
			<field name="arch" type="xml">
				<xpath expr="//field[@name='context']" position="replace">
					<field name="context">{"search_default_user_id":uid,'default_year':context_today().strftime('%Y')}</field>
				</xpath>
			</field>
		</record>          
        -->
		<record model="ir.ui.view" id="view_purchase_requisition_filter">
			<field name="name">purchase.requisition.list.select</field>
			<field name="model">purchase.requisition</field>
			<field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_filter" />
			<field name="arch" type="xml">
				<xpath expr="//field[@name='product_id']" position="after">
					<field name="year"/>
					<filter string="Current Year" name="currentyear"
						domain="[('year','=',context_today().strftime('%Y'))]" />
				</xpath>
			</field>
		</record>

	    <record model="ir.actions.act_window" id="purchase_requisition.action_purchase_requisition">
	        <field name="name">Procurement</field>
	        <field name="type">ir.actions.act_window</field>
	        <field name="res_model">purchase.requisition</field>
	        <field name="view_mode">tree,form</field>
	        <field name="context">{'search_default_year':context_today().strftime('%Y')}</field>
	        <field name="search_view_id" ref="purchase_requisition.view_purchase_requisition_filter"/>
	        <field name="help" type="html">
	          <p class="oe_view_nocontent_create">
	            Click to start a new purchase agreement.
	          </p><p>
	            Example of purchase agreements include call for tenders and blanket orders.
	          </p><p>
	            In a call for tenders, you can record the products you need to buy
	            and generate the creation of RfQs to vendors. Once the tenders have
	            been registered, you can review and compare them and you can
	            validate some and cancel others.
	          </p><p>
	            For a blanket order, you can record an agreement for a specifc period
	            (e.g. a year) and you order products within this agreement, benefiting
	            from the negotiated prices.
	          </p>
	        </field>
	    </record>
	        
        <!-- purchase requisition -->
		<record model="ir.ui.view" id="view_purchase_requisition_form">
			<field name="name">purchase.requisition.form.inherit</field>
			<field name="model">purchase.requisition</field>
			<field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form" />
			<field name="arch" type="xml">
				<xpath expr="//field[@name='state']" position="replace">
					<field name="state"   widget="statusbar" statusbar_visible="draft,in_progress,open,done" attrs="{'invisible': [('tr_level','!=',1)]}"/>
					<field name="state_2" widget="statusbar" statusbar_visible="draft,in_progress,philgeps,postqual,open,done" attrs="{'invisible': [('tr_level','!=',2)]}"/>
					<field name="state_3" widget="statusbar" statusbar_visible="draft,in_progress,philgeps,postqual,open,reso,po_obr,done" attrs="{'invisible': [('tr_level','!=',3)]}"/>
					<field name="state_4" widget="statusbar" statusbar_visible="draft,in_progress,prebid,philgeps,postqual,open,reso,po_obr,done" attrs="{'invisible': [('tr_level','!=',4)]}"/>
			
					<button name="btn_philgeps" string="PhilGEPS" type="object" 
						class="btn-primary" attrs="{'invisible': [('shw_philgeps','=',False)]}"
						groups="procurement_lgu.lguproc_incharge"/>
					<button name="btn_prebid" string="Pre Bid" type="object" 
						class="btn-primary" attrs="{'invisible': [('shw_prebid','=',False)]}"
						groups="procurement_lgu.lguproc_incharge"/>
					<button name="btn_postqual" string="Post Qualification" 
						type="object" class="btn-primary" attrs="{'invisible': [('shw_postqual','=',False)]}"
						groups="procurement_lgu.lguproc_incharge,procurement_lgu.lguproc_head"/>
					<button name="btn_reso" string="Resolution" type="object" class="btn-primary" attrs="{'invisible': [('shw_reso','=',False)]}"
						groups="procurement_lgu.lguproc_incharge,procurement_lgu.lguproc_head"/>
					<button name="btn_po_obr" string="Receipt of Docs" type="object" class="btn-primary" attrs="{'invisible': [('shw_po_obr','=',False)]}"
						groups="procurement_lgu.lguproc_incharge,procurement_lgu.lguproc_head"/>
					<button name="draft" class="oe_highlight" states="in_progress,prebid,philgeps,postqual,open,reso,po_obr,cancel" string="Set to Draft" type="object" groups="procurement_lgu.lguproc_head"/>
				</xpath>
				<xpath expr="//button[@name='action_open']" position="replace">
					<button name="action_open" string="Bid Selection" type="object" class="btn-primary" attrs="{'invisible': [('shw_open','=',False)]}"/>
				</xpath>			
			
				<xpath expr="//field[@name='user_id']" position="before">
					<field name="pu_id" context="{'filter_pu':True}" attrs="{'readonly': [('state', 'in', ('done'))]}"/>
					<field name="project_id" attrs="{'readonly': [('state', 'in', ('done'))]}"
						context="{'pu_id':pu_id, 'filter_project': True}"/>
					<field name="source_id" attrs="{'readonly': [('state', 'in', ('done'))]}"/>
					<field name="project_loc" attrs="{'readonly': [('state', 'in', ('done'))]}"/>
					<!--
					<field name="program_id" attrs="{'readonly': [('state', 'in', ('done'))]}"
						context="{'pu_id':pu_id, 'project_id': project_id,'program_id':program_id,'filter_program': True}"/>
					-->
					<field name="shw_prebid" invisible="1"/>
					<field name="shw_philgeps" invisible="1"/>
					<field name="shw_postqual" invisible="1"/>
					<field name="shw_reso" invisible="1"/>
					<field name="shw_po_obr" invisible="1"/>
					<field name="shw_open" invisible="1"/>
				</xpath>
				
				<xpath expr="//field[@name='vendor_id']" position="after">
					<field name="mode_id" attrs="{'readonly': [('state', 'in', ('done'))]}"/>
				</xpath>
								
				<xpath expr="//field[@name='date_end']" position="before">
					<field name="year" attrs="{'readonly': [('state', 'in', ('done'))]}"/>
					<field name="transaction_level" attrs="{'readonly': [('state', 'in', ('done'))]}"/>
					<field name="tr_level" invisible="1"/>
					<field name="approved_budget"/>
					<field name="place_bid"/>
					<field name="bid_open"/>
				</xpath>
				<xpath expr="//field[@name='ordering_date']" position="replace">
					<field name="ordering_date" required="1" attrs="{'readonly': [('state', 'in', ('done'))]}"/>
				</xpath>
				<xpath expr="//field[@name='product_id']" position="replace">
					<!--
					<field name="product_id" 
						context="{'quantity':product_qty,'project_id':parent.project_id, 
								'company_id': parent.company_id, 'filter_procurement': True, 
								'pu_id':parent.pu_id, 'year':parent.year}"
					/>
					-->
					<field name="account_id" required="1"
						context="{'quantity':product_qty,'project_id':parent.project_id, 
								'company_id': parent.company_id, 'filter_procurement': True, 
								'pu_id':parent.pu_id, 'year':parent.year}"/>
					<field name="product_id"/>
				</xpath>

				<xpath expr="//field[@name='price_unit']" position="after">
<!--					<field name="taxes_id" widget="many2many_tags" domain="[('type_tax_use','=','purchase')]" context="{'default_type_tax_use': 'purchase'}" />-->
					<field name="price_subtotal" widget="monetary"/>
				</xpath>

				<xpath expr="//field[@name='line_ids']" position="after">
                    <group class="oe_subtotal_footer oe_right">
                        <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <div class="oe_subtotal_footer_separator oe_inline">
                            <label for="amount_total"/>
                        </div>
                        <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </group>
				</xpath>

				<xpath expr="//notebook[last()]" position="inside">
                    <page string="Dates">
                        <field name="line_dates">
                            <tree string="Dates" editable="bottom"  create="false">
                                <field name="status_date"/>
                                <field name="state" readonly="True"/>
                                <field name="description"/>
                            </tree>
                        </field>
                    </page>
					<page string="Signatories">
						<group>
							<group>
								<field name="mayor"/>
								<field name="bac_chairman"/>
								<field name="bac_vicechairman"/>
							</group>
							<group>
								<field name="bac_member1"/>
								<field name="bac_member2"/>
								<field name="bac_member3"/>
								<field name="requested_by"/>
							</group>
							<group>
								<field name="end_user"/>
								<field name="bac_twg"/>
								<field name="observer1"/>
								<field name="observer2"/>
							</group>
						</group>
					</page>
					<page string="Minutes of Bids">
						<group>
							<field name="reso_number"/>
							<field name="attendance_ids" mode="tree" attrs="{'invisible': [('state', 'not in', ('open','reso','po_obr','done'))]}">
								<tree editable="bottom">
									<field name="sequence" widget="handle"/>
									<field name="rec_type"/>
									<field name="name"/>
									<field name="designation"/>
								</tree>
							</field>
						</group>
					</page>

				</xpath>
			</field>
		</record>           

		<record model="ir.ui.view" id="view_purchase_requisition_tree">
			<field name="name">purchase.requisition.tree.inherit</field>
			<field name="model">purchase.requisition</field>
			<field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_tree" />
			<field name="arch" type="xml">
				<xpath expr="//field[@name='name']" position="after">
					<field name="pu_id"/>
					<field name="project_id"/>
				</xpath>
				<xpath expr="//field[@name='state']" position="before">
					<field name="amount_total"/>
					<field name="year"/>
					<field name="transaction_level"/>
					<field name="mode_id"/>
				</xpath>
			</field>
		</record>
		
