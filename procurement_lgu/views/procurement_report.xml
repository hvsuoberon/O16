    <report
        string="Notice of Award"
        id="report_notice_of_award"
        model="purchase.order"
        report_type="qweb-pdf"
        name="procurement_lgu.notice_of_award"
        file="procurement_lgu.notice_of_award"
        menu="True"
        paperformat="paperformat_legal_portrait"
    />
    <report
        string="Notice to Proceed"
        id="report_notice_to_proceed"
        model="purchase.order"
        report_type="qweb-pdf"
        name="procurement_lgu.notice_to_proceed"
        file="procurement_lgu.notice_to_proceed"
        menu="True"
        paperformat="paperformat_legal_portrait"
    />
