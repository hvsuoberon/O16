<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

		<record id="make_invisible1" model="res.groups">
			<field name="name">Invisible</field>
		</record>    
		
		<record model="ir.ui.menu" id="purchase.menu_purchase_rfq">
			<field name="groups_id" eval="[(6,0,[ref('make_invisible1')])]"/>
		</record>

		<record model="ir.ui.menu" id="purchase.menu_purchase_form_action">
			<field name="groups_id" eval="[(6,0,[ref('make_invisible1')])]"/>
		</record>

		<record model="ir.ui.menu" id="purchase_requisition.menu_purchase_requisition_pro_mgt">
			<field name="groups_id" eval="[(6,0,[ref('make_invisible1')])]"/>
		</record>

		<record model="ir.ui.menu" id="stock.menu_stock_root">
			<field name="groups_id" eval="[(6,0,[ref('make_invisible1')])]"/>
		</record>
		
		<record model="ir.ui.menu" id="account.menu_finance">
			<field name="groups_id" eval="[(6,0,[ref('make_invisible1')])]"/>
		</record>

        <record model="ir.ui.menu" id="purchase.purchase_report_main">
			<field name="groups_id" eval="[(6,0,[ref('make_invisible1')])]"/>
		</record>
    	<!-- ################################################ start -->
        <record model="ir.ui.view" id="purchase_order_level_form_view">
            <field name="name">purchase.order.level.form</field>
            <field name="model">purchase.order.level</field>
            <field name="arch" type="xml">
                <form string="Level">
                    <sheet>
                        <group>
                        	<field name="name"/>
                            <field name="level"/>
                            <field name="amount_from"/>
                            <field name="amount_to"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record model="ir.ui.view" id="purchase_order_level_search_view">
            <field name="name">purchase.order.level.search</field>
            <field name="model">purchase.order.level</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="level"/>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="purchase_order_level_tree_view">
            <field name="name">purchase.order.level.tree</field>
            <field name="model">purchase.order.level</field>
            <field name="arch" type="xml">
                <tree string="Level Tree">
                    <field name="name"/>
                    <field name="level"/>
                    <field name="amount_from"/>
                    <field name="amount_to"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="purchase_order_level_list_action">
            <field name="name">Transaction Level</field>
            <field name="res_model">purchase.order.level</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_currentyear': True}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first transaction level
                </p>
            </field>
        </record>

        <record id="action_res_users" model="ir.actions.act_window">
            <field name="name">Users</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.users</field>
            <field name="view_id" ref="base.view_users_tree"/>
            <field name="search_view_id" ref="base.view_users_search"/>
            <field name="domain">[('login', '!=', 'admin')]</field>
            <field name="context">{'search_default_no_share': 1}</field>
            <field name="help">Create and manage users that will connect to the system. Users can be deactivated should there be a period of time during which they will/should not connect to the system. You can assign them groups in order to give them specific access to the applications they need to use in the system.</field>
        </record>
        <record id="action_res_users_view1" model="ir.actions.act_window.view">
            <field eval="10" name="sequence"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="base.view_users_tree"/>
            <field name="act_window_id" ref="procurement_lgu.action_res_users"/>
        </record>
        <record id="action_res_users_view2" model="ir.actions.act_window.view">
            <field eval="20" name="sequence"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="base.view_users_form"/>
            <field name="act_window_id" ref="procurement_lgu.action_res_users"/>
        </record>    
	    <menuitem
	        id="menu_purchase_order_level"
	        sequence="100"
	        parent="purchase.menu_purchase_config"
	        action="purchase_order_level_list_action"/>

		<menuitem id="procurement_project_menu" 
			name="Project" 
			parent="purchase.menu_purchase_config"
            action="procurementproject_list_action"/>   

		<menuitem id="procurement_signatory_menu"
			name="Signatories"
			parent="purchase.menu_purchase_config"
            action="procurement_signatory_list_action"/>
		<!--
		<menuitem id="procurement_program_menu" 
			name="Program" 
			parent="purchase.menu_purchase_config"
            action="procurementprogram_list_action"/>   
		-->

        <menuitem id="lguproc_users_menu" name="Users" 
        	parent="purchase.menu_purchase_config"
        	sequence="110"
			action="procurement_lgu.action_res_users" groups="procurement_lgu.lguproc_head"/>
	
		<!-- ################################################ end -->
    
   
	</data>
</odoo>