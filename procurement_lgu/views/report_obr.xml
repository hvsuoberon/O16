<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="report_obr">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
			<t t-call="budgeting.custom_external_layout">
			     
                <div class="page" style="margin:13px;">
                	<div class="oe_structure"/>
	                <h2 class="text-center">
	                    <strong>
	                        <span t-if="o.state not in ['xxx']">Obligation Request</span>
	                    </strong>
	                </h2>
	
	              	<div class="row">
	                    <div class="col-xs-5">
	                        <strong>
	                            <span>Transaction #:</span>
	                        </strong>
	                        <span t-field="o.name"/>
	                    </div>
	                	<div class="col-xs-2"/>
	                    <div class="col-xs-5">
	                        <strong>
	                            <span>Date:</span>
	                        </strong>
	                        <span t-field="o.date"/>
	                    </div>
	               	</div>
                    <div class="row">
	                    <div class="col-xs-5">
	                        <strong>
	                            <span>Party:</span>
	                        </strong>
	                        <span t-field="o.partner_id.name"/>
	                    </div>
	                	<div class="col-xs-2"/>
	                    <div class="col-xs-5">
	                        <strong>
	                            <span>Budget Period:</span>
	                        </strong>
	                        <span t-field="o.period_id.name"/>
	                    </div>                    
	                </div>
                    <div class="row">
	                    <div class="col-xs-5">
	                        <strong>
	                            <span>PR Reference:</span>
	                        </strong>
	                        <span t-field="o.pr_id.name"/>
	                    </div>
						<div class="col-xs-2"/>
	                    <div class="col-xs-5">
	                        <strong>
	                            <span>Date of Approval:</span>
	                        </strong>
	                        <span t-field="o.date_approved"/>
	                    </div>                   
	                </div>
                    <div class="row">
	                    <div class="col-xs-12">
	                        <strong>
	                            <span>Purpose:</span>
	                        </strong>
	                        <span t-field="o.purpose"/>
	                    </div>
	                </div>	                
                    <br/>
                    <table class="table table-condensed">
						<thead>
                        	<tr>
                                <th style="border: 2px solid black;text-align:center;font-size:12px;">Account Title</th>
                                <th style="border: 2px solid black;text-align:center;font-size:12px;">Current Balance</th>
                                <th style="border: 2px solid black;text-align:center;font-size:12px;">Amount</th>
                                <th style="border: 2px solid black;text-align:center;font-size:12px;">New Balance</th>
                            </tr>
                        </thead>                    
                    	<tbody class="pr_tbody">
							<tr t-foreach="o.obrdet_ids" t-as="l">
								<td style="border: 1px solid black;text-align:left; font-size:11px;">
                                    <span t-field="l.account_id.name"/>
                                </td>
								<td style="border: 1px solid black;text-align:right; font-size:11px;">
                                    <span t-esc="'{0:,.2f}'.format(int(l.currentbal))"/>
                                </td>
								<td style="border: 1px solid black;text-align:right; font-size:11px;">
                                    <span t-esc="'{0:,.2f}'.format(int(l.amount))"/>
                                </td>
								<td style="border: 1px solid black;text-align:right; font-size:11px;">
                                    <span t-esc="'{0:,.2f}'.format(int(l.newbal))"/>
                                </td>                                
							</tr>                    		
                    	</tbody>
                    </table>
                    
                    <!--
                    <div class="row" name="total">
                    	<div class="col-xs-4 pull-right">
                        	<table class="table table-condensed">
                          		<tr class="border-black">
                            		<td><strong>Total:</strong></td>
                     				<t t-esc="sum(l.amount for l in o.prdet_ids) " />
                        		</tr>
                    	    </table>
                		</div>
            		</div>
            		-->
                    <br/>
                    <div class="row">
                        <div class="col-xs-4">
                            <strong>
                                <p style="font-size:12px;margin-top:-8px;"> Prepared By: </p>
                            </strong>
                        </div>
                        <div class="col-xs-4">
                            <strong>
                                <p style="font-size:12px;margin-top:-8px;"> Checked By:  </p>
                            </strong>
                        </div>
                        <div class="col-xs-4">
                            <strong>
                                <p style="font-size:12px;margin-top:-8px;"> Approved By:  </p>
                            </strong>
                        </div>
                    </div>
                    <br/>            		
			        <div class="row zero_min_height">
			            <div class="col-xs-3">
			                <div style="border-bottom: 1px solid black;"></div>
			            </div>
			            <div class="col-xs-1"/>
			            <div class="col-xs-3">
			                <div style="border-bottom: 1px solid black;"></div>
			            </div>
			            <div class="col-xs-1"/>
			            <div class="col-xs-3">
			                <div style="border-bottom: 1px solid black;"></div>
			            </div>
			            <div class="col-xs-1"/>
			        </div>                      
			        <div class="row">
			            <div class="col-xs-3">
			                <p style="font-size:11px;margin-top:1px;text-align: center;"> Encoder  </p>
			            </div>
			            <div class="col-xs-1"/>
			            <div class="col-xs-3">
			                <p style="font-size:11px;margin-top:1px;text-align: center;"> Bookkeeper  </p>
			            </div>
			            <div class="col-xs-1"/>
			            <div class="col-xs-3">
			                <p style="font-size:11px;margin-top:1px;text-align: center;"> Budget Officer  </p>
			            </div>
			            <div class="col-xs-1"/>
			        </div>  
                </div>
                
            </t>
        </t>
    </t>
</template>

</odoo>
