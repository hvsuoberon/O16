	<template id="custom_external_layout_header">
    	<div class="header">
     	   	<div class="row">
           		<div class="col-xs-9">
					<br/>
					<br/>
         			<p style="font-size:20px;margin-top:-13px;"><b> MUNICIPALITY OF BAGUMBAYAN </b></p>
         			<p style="font-size:14px;margin-top:-8px;"> Province of Sultan Kudarat  </p>
         			<p style="font-size:14px;margin-top:-14px;"> Republic of the Philippines  </p>
         			<br/>
           		</div>
     		
                <div class="col-xs-3 pull-right">
	                <img t-if="company.logo" t-att-src="'data:image/png;base64,%s' % company.logo" style="background:white;position:absolute;height: auto; width: auto; max-width: 100; max-height: 100px; right:8px;top:5px"/>
