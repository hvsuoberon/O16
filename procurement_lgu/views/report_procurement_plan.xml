<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="procurement_plan">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
			<t t-call="procurement_lgu.custom_external_layout">
			     
                <div class="page" style="margin:0px;">
                	<div class="oe_structure"/>
                	<br/>
                	<br/>
	                <h4 class="text-center">
	                    <strong>
	                    
	                        <span t-if="o.trans_type in ['ppmp']">PROJECT PROCUREMENT MANAGEMENT PLAN FOR COMMON USE-SUPPLIES AND EQUIPMENT FOR CY </span>
	                        <span t-if="o.trans_type in ['adj']">PROJECT PROCUREMENT MANAGEMENT PLAN ADJUSTMENT FOR COMMON USE-SUPPLIES AND EQUIPMENT FOR CY </span>
	                        <span t-field="o.year"/>
	                    </strong>
	                </h4>
	
	              	<div class="row">
	                    <div class="col-xs-6">
	                        <strong>
	                            <span>Procurement Unit:</span>
	                        </strong>
	                        <span t-field="o.partner_id.name"/>
	                    </div>
	               	</div>
                    <br/>
                    <table class="table table-condensed">
						<thead>
							<table width="100%" height="40mm">
								<tr>
									<td style="font-weight: bold;font-size:13px;border: 1px solid black;text-align: center;height:25px;width:2%;vertical-align: middle;">No.</td>
				                	<td style="font-weight: bold;font-size:13px;border: 1px solid black;text-align: center;height:25px;width:17%;vertical-align: middle;">General Description</td>
				                	<td style="font-weight: bold;font-size:13px;border: 1px solid black;text-align: center;height:25px;width:9%;vertical-align: middle;">Unit of Measure</td>
				                	<td style="font-weight: bold;font-size:13px;border: 1px solid black;text-align: center;height:25px;width:9%;vertical-align: middle;">Qty</td>
				                	<td style="font-weight: bold;font-size:13px;border: 1px solid black;text-align: center;height:25px;width:9%;vertical-align: middle;">Unit Price</td>
				                	<td style="font-weight: bold;font-size:13px;border: 1px solid black;text-align: center;height:25px;width:9%;vertical-align: middle;">Estimated Budget</td>
				                	<td style="font-weight: bold;font-size:13px;border: 1px solid black;text-align: center;height:25px;width:9%;vertical-align: middle;">Mode of Procurement</td>
				                	<td style="font-weight: bold;font-size:13px;border: 1px solid black;text-align: center;height:25px;width:36%;vertical-align: middle;">
										<table width="100%" height="20mm">
											<td style="font-weight: bold;font-size:13px;border-bottom: 1px solid black;text-align: center;height:25px;width:100%;vertical-align: middle;">SCHEDULE/MILESTONE OF ACTIVITIES</td>
										</table>
										<table width="100%" height="20mm">
											<td style="font-weight: bold;font-size:13px;text-align: center;height:25px;width:8%;vertical-align: middle;">Jan</td>
						                	<td style="font-weight: bold;font-size:13px;border-left: 1px solid black;text-align: center;height:25px;width:8%;vertical-align: middle;">Feb</td>
						                	<td style="font-weight: bold;font-size:13px;border-left: 1px solid black;text-align: center;height:25px;width:8%;vertical-align: middle;">Mar</td>
						                	<td style="font-weight: bold;font-size:13px;border-left: 1px solid black;text-align: center;height:25px;width:8%;vertical-align: middle;">Apr</td>
						                	<td style="font-weight: bold;font-size:13px;border-left: 1px solid black;text-align: center;height:25px;width:8%;vertical-align: middle;">May</td>
						                	<td style="font-weight: bold;font-size:13px;border-left: 1px solid black;text-align: center;height:25px;width:8%;vertical-align: middle;">Jun</td>
						                	<td style="font-weight: bold;font-size:13px;border-left: 1px solid black;text-align: center;height:25px;width:8%;vertical-align: middle;">Jul</td>
						                	<td style="font-weight: bold;font-size:13px;border-left: 1px solid black;text-align: center;height:25px;width:8%;vertical-align: middle;">Aug</td>
						                	<td style="font-weight: bold;font-size:13px;border-left: 1px solid black;text-align: center;height:25px;width:8%;vertical-align: middle;">Sep</td>
						                	<td style="font-weight: bold;font-size:13px;border-left: 1px solid black;text-align: center;height:25px;width:8%;vertical-align: middle;">Oct</td>
						                	<td style="font-weight: bold;font-size:13px;border-left: 1px solid black;text-align: center;height:25px;width:8%;vertical-align: middle;">Nov</td>
						                	<td style="font-weight: bold;font-size:13px;border-left: 1px solid black;text-align: center;height:25px;width:8%;vertical-align: middle;">Dec</td>				                		
										</table>
				                	</td>
								</tr>
							</table>
                        </thead>                
    					<t t-set="cntr" t-value="1"/>
                    	<tbody class="pp_body">
                    		<t t-foreach="o.group_project()" t-as="l">							
                    			<table width="100%" height="20mm">
                    				<td style="font-weight: bold;font-size:13px;border: 1px solid black;text-align:left; height:20px;width:100%;vertical-align: middle;">
                    					<span t-field="l.name"/>
                    				</td>
	                   			</table>
                  				<t t-foreach="o._get_details(l.id)" t-as="ll">
									<table width="100%" height="20mm">
										<tr>
											<td style="font-size:11px;border: 1px solid black;text-align: center;height:20px;width:2%;vertical-align: middle;"><span t-esc="cntr"/></td>
						                	<td style="font-size:11px;border: 1px solid black;text-align: left;height:20px;width:17%;vertical-align: middle; margin:3px;"><span t-esc="ll[0]"/></td>
						                	<td style="font-size:11px;border: 1px solid black;text-align: left;height:20px;width:9%;vertical-align: middle;margin:3px;"><span t-esc="ll[1]"/></td>
						                	<td style="font-size:11px;border: 1px solid black;text-align: center;height:20px;width:9%;vertical-align: middle;"><span t-esc="ll[2]"/></td>
						                	<td style="font-size:11px;border: 1px solid black;text-align: right;height:20px;width:9%;vertical-align: middle;margin-right:3px;"><span t-esc="'{0:,.2f}'.format(int(ll[3]))"/></td>
						                	<td style="font-size:11px;border: 1px solid black;text-align: right;height:20px;width:9%;vertical-align: middle;margin-right:3px;"><span t-esc="'{0:,.2f}'.format(int(ll[4]))"/></td>
						                	<td style="font-size:11px;border: 1px solid black;text-align: center;height:20px;width:9%;vertical-align: middle;"><span t-esc="ll[5]"/></td>
						                	<td style="font-size:11px;border: 1px solid black;text-align: center;height:20px;width:36%;vertical-align: middle;">
												<table width="100%" height="20mm">
													<td style="font-size:11px;text-align: center;height:20px;width:8%;vertical-align: middle;"><span t-esc="ll[6]"/></td>
								                	<td style="font-size:11px;border-left: 1px solid black;text-align: center;height:20px;width:8%;vertical-align: middle;"><span t-esc="ll[7]"/></td>
								                	<td style="font-size:11px;border-left: 1px solid black;text-align: center;height:20px;width:8%;vertical-align: middle;"><span t-esc="ll[8]"/></td>
								                	<td style="font-size:11px;border-left: 1px solid black;text-align: center;height:20px;width:8%;vertical-align: middle;"><span t-esc="ll[9]"/></td>
								                	<td style="font-size:11px;border-left: 1px solid black;text-align: center;height:20px;width:8%;vertical-align: middle;"><span t-esc="ll[10]"/></td>
								                	<td style="font-size:11px;border-left: 1px solid black;text-align: center;height:20px;width:8%;vertical-align: middle;"><span t-esc="ll[11]"/></td>
								                	<td style="font-size:11px;border-left: 1px solid black;text-align: center;height:20px;width:8%;vertical-align: middle;"><span t-esc="ll[12]"/></td>
								                	<td style="font-size:11px;border-left: 1px solid black;text-align: center;height:20px;width:8%;vertical-align: middle;"><span t-esc="ll[13]"/></td>
								                	<td style="font-size:11px;border-left: 1px solid black;text-align: center;height:20px;width:8%;vertical-align: middle;"><span t-esc="ll[14]"/></td>
								                	<td style="font-size:11px;border-left: 1px solid black;text-align: center;height:20px;width:8%;vertical-align: middle;"><span t-esc="ll[15]"/></td>
								                	<td style="font-size:11px;border-left: 1px solid black;text-align: center;height:20px;width:8%;vertical-align: middle;"><span t-esc="ll[16]"/></td>
								                	<td style="font-size:11px;border-left: 1px solid black;text-align: center;height:20px;width:8%;vertical-align: middle;"><span t-esc="ll[17]"/></td>				                		
												</table>
						                	</td>
						                	<t t-set="cntr" t-value="cntr+1"/>
										</tr>
									</table>
                				</t>		
                    		</t>
                    	</tbody>	
                    		<!--
							<tr t-foreach="o.appdet_ids" t-as="l">
								<td style="border: 1px solid black;text-align:left; font-size:11px; width:45%">
                                    <span t-field="l.account_id.name"/>
                                </td>
								<td style="border: 1px solid black;text-align:right; font-size:11px; width:25%">
                                    <span t-esc="'{0:,.2f}'.format(int(l.amount))"/>
                                </td>
							</tr>
							-->                    		
                    </table>
                    
